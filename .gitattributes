* text=auto
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.json text eol=lf
# Preserve vendor header formatting without reformatting upstream SDK sources.
io/driver/** -whitespace
io/hikrobot/include/** -whitespace
io/mindvision/include/** -whitespace
# Navigation's reviewed-source manifests hash exact imported bytes, including
# existing line endings. Preserve them across Windows/Linux checkout.
navigation/** -text whitespace=cr-at-eol,-blank-at-eof
navigation/**/*.patch -whitespace
