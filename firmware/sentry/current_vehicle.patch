diff --git a/STM32F405/mission_counter.h b/STM32F405/mission_counter.h
--- /dev/null
+++ b/STM32F405/mission_counter.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstdint>
+#include <cmath>
+
+// Net encoder travel in the firing direction. A complete bullet_step is one
+// completed feed, not a full disk revolution and not proof of a projectile exit.
+struct MissionFeedCounter {
+    uint32_t count=0,generation=0;
+    int32_t previous=0;
+    double remainder=0;
+    bool initialized=false,continuous=false;
+    void Update(bool fresh,uint32_t gen,int32_t sum,float step) {
+        if (!fresh || !std::isfinite(step) || step<=1.f) { continuous=false; return; }
+        if (!initialized || !continuous || gen!=generation) {
+            if (initialized) ++generation_serial;
+            initialized=continuous=true;generation=gen;previous=sum;remainder=0;return;
+        }
+        // Modular subtraction survives the signed 32-bit sum-angle wrap.
+        const int32_t delta=int32_t(uint32_t(previous)-uint32_t(sum));previous=sum;
+        remainder+=delta;
+        // Allow at most 32 encoder counts (and at most 0.1% of a step) of
+        // position quantization/settling error. Subtract the full step so this
+        // tolerance cannot accumulate or count threshold vibration twice.
+        const double tolerance=step*.001<32. ? step*.001:32.;
+        while (remainder>=step-tolerance) { if(count!=0xffffffffu)++count;remainder-=step; }
+    }
+    uint32_t generation_serial=0;
+};
