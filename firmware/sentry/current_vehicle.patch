+DMMOTOR& DMMOTOR::State_Decode(uint8_t idata[][8])
+{
+    uint8_t slot = 0xff;
+    for (uint8_t i=0; i<sizeof(DMmotor)/sizeof(DMmotor[0]); ++i)
+        if (&DMmotor[i] == this) { slot=i; break; }
+    if (slot==0xff) return *this;
+    uint8_t bytes[8];
+    taskENTER_CRITICAL();
+    if (!feedback_seen_ || uint32_t(HAL_GetTick()-feedback_ms_) > 100u)
+    {
+        decoded=false; setSpeed=0;
+        taskEXIT_CRITICAL();
+        return *this;
+    }
+    memcpy(bytes,idata[slot],8);
+    const uint32_t generation=feedback_generation_;
+    taskEXIT_CRITICAL();
+    if ((bytes[0]&0x0fu)!=(ID&0x0fu)) return *this;
+    const bool recovering=!decoded || decoded_generation_!=generation;
+    status=bytes[0]>>4;
+    pos=uint_to_float((bytes[1]<<8)|bytes[2],P_MIN,P_MAX,16);
+    curSpeed=uint_to_float((bytes[3]<<4)|(bytes[4]>>4),V_MIN,V_MAX,12);
+    current=uint_to_float(bytes[5]|((bytes[4]&0x0f)<<8),C_MIN,C_MAX,12);
+    torque=current*KT;
+    if (recovering) { setPos=pos; setSpeed=0; }
+    decoded_generation_=generation;
+    decoded=true;
+    return *this;
 }
 
 
